<?xml version="1.0" encoding="UTF-8"?>
<!-- Boleta (comprobante) de una venta, en formato de ticket.
     Se rellena con JRBeanCollectionDataSource a partir de modelo.Reporte y
     recibe la cabecera de la venta (cliente, fecha y vendedor) como parametros. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="boleta_venta"
              pageWidth="420" pageHeight="595" columnWidth="380"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="pIdVenta" class="java.lang.Integer"/>
    <parameter name="pCliente" class="java.lang.String"/>
    <parameter name="pFecha" class="java.lang.String"/>
    <parameter name="pVendedor" class="java.lang.String"/>

    <field name="nombreProducto" class="java.lang.String"/>
    <field name="cantidad" class="java.lang.Integer"/>
    <field name="precioUnit" class="java.lang.Double"/>
    <field name="total" class="java.lang.Double"/>

    <variable name="totalGeneral" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{total}]]></variableExpression>
    </variable>

    <title>
        <band height="106">
            <staticText>
                <reportElement x="0" y="0" width="380" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="13" isBold="true"/>
                </textElement>
                <text><![CDATA[COMERCIAL AUTOPARTES S.A.C.]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="19" width="380" height="13"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[BOLETA DE VENTA]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="33" width="380" height="12"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["N° " + String.format("%06d", $P{pIdVenta})]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="50" width="380" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineStyle="Dashed" lineColor="#94A3B8"/>
                </graphicElement>
            </line>

            <staticText>
                <reportElement x="0" y="56" width="60" height="12" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <text><![CDATA[Cliente:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="60" y="56" width="320" height="12"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{pCliente}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="70" width="60" height="12" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <text><![CDATA[Fecha:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="60" y="70" width="320" height="12"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{pFecha}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="84" width="60" height="12" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <text><![CDATA[Vendedor:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="60" y="84" width="320" height="12"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{pVendedor}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <line>
                <reportElement x="0" y="0" width="380" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineStyle="Dashed" lineColor="#94A3B8"/>
                </graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="5" width="42" height="12" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[CANT.]]></text>
            </staticText>
            <staticText>
                <reportElement x="42" y="5" width="248" height="12" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[DESCRIPCION]]></text>
            </staticText>
            <staticText>
                <reportElement x="290" y="5" width="90" height="12" forecolor="#64748B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[IMPORTE]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="16">
            <textField>
                <reportElement x="0" y="0" width="42" height="16"/>
                <textElement verticalAlignment="Top">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{cantidad} + "x"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="42" y="0" width="248" height="16"/>
                <textElement verticalAlignment="Top">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nombreProducto}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="290" y="0" width="90" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Top">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{total}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="78">
            <line>
                <reportElement x="0" y="0" width="380" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineStyle="Dashed" lineColor="#94A3B8"/>
                </graphicElement>
            </line>
            <staticText>
                <reportElement x="190" y="8" width="100" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[TOTAL]]></text>
            </staticText>
            <textField pattern="'S/ '#,##0.00">
                <reportElement x="290" y="8" width="90" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{totalGeneral}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="38" width="380" height="10" forecolor="#64748B"/>
                <textElement textAlignment="Center">
                    <font fontName="Monospaced" size="7"/>
                </textElement>
                <text><![CDATA[Documento de control interno (no tributario)]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="52" width="380" height="12"/>
                <textElement textAlignment="Center">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <text><![CDATA[Gracias por su compra]]></text>
            </staticText>
        </band>
    </summary>

</jasperReport>
